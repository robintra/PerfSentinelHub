{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "L'instance Prometheus qui collecte l'endpoint /metrics de PerfSentinelHub.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "timeseries",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Version en service",
      "description": "La version que ce Hub publie sur /metrics. build_info vaut toujours 1, donc le panneau affiche le label version plutôt que la valeur. Deux lignes ici signifient qu'un déploiement est à moitié fait.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_build_info{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "none"
      }
    },
    {
      "title": "Daemons injoignables",
      "description": "Les daemons dont le dernier poll a échoué. Seul un daemon est compté : un backend de traces n'est jamais interrogé, et un daemon que le Hub n'a jamais atteint ne publie aucune série plutôt qu'une valeur trompeuse, donc aucun des deux n'apparaît ici. Un push reçu d'un daemon n'efface pas cet état, car l'accessibilité est la route du Hub vers le daemon et non l'inverse.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count(perf_sentinel_hub_source_reachable{job=~\"$job\"} == 0) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "title": "File d'analyse",
      "description": "Les runs acceptés et pas encore pris par un worker. Un nombre qui ne cesse de monter signifie que Hub:Analysis:Workers est en dessous du rythme des soumissions, pas qu'un run est bloqué : un run bloqué reste en running, ce que montre le panneau plus bas.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_analysis_queue_depth{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "title": "Runs interrompus",
      "description": "Les runs que le Hub a marqués interrompus parce que le processus s'est arrêté pendant leur exécution ou alors qu'ils attendaient encore. Rien n'est rejoué tout seul, ils attendent donc une intervention humaine. Ils expirent sur Hub:Analysis:RunRetention comme tout run terminé, donc ce nombre baisse sans que personne n'agisse.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_analysis_runs{job=~\"$job\", status=\"interrupted\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
    },
    {
      "title": "Durée d'injoignabilité de chaque daemon",
      "description": "Zéro tant qu'un daemon répond, absent pour un daemon que le Hub n'a jamais observé. Le Hub réessaie avec un repli exponentiel borné (1 s doublée jusqu'à un plafond de 300 s), donc un pic court est une nouvelle tentative et non une panne. C'est une ligne qui ne cesse de monter qui mérite d'être lue.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_source_unreachable_seconds{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Âge du dernier poll réussi",
      "description": "Un daemon jamais interrogé avec succès n'a aucune série plutôt qu'un zéro, parce que zéro se lirait comme un succès à l'instant même. Une ligne absente signifie donc jamais, et il ne faut pas combler le trou avec la valeur d'à côté.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_source_last_success_seconds{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Runs d'analyse par statut",
      "description": "Une gauge, pas un compteur. Un run passe d'un statut à l'autre et un run terminé expire sur Hub:Analysis:RunRetention, donc chaque série descend autant qu'elle monte et increase() n'a de sens sur aucune d'elles. Chaque statut est publié même à zéro, donc une série qui disparaît est un échec de collecte et non un état vide.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_analysis_runs{job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Accessibilité de la flotte",
      "description": "Une ligne par daemon que le Hub a réellement observé. Joignable désigne la route du Hub vers ce daemon, un autre chemin à travers d'autres pare-feux que le push du daemon vers le Hub, donc un daemon peut pousser avec succès tout en étant injoignable ici. Un daemon sans ligne n'a jamais été atteint, c'est pourquoi le compteur plus haut et ce tableau peuvent diverger.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "perf_sentinel_hub_source_reachable{job=~\"$job\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "injoignable",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "joignable",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "__name__"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "title": "Imports refusés par motif",
      "description": "Les imports que le Hub a refusés. Contrairement à source_last_import_seconds, que ce tableau de bord laisse de côté parce qu'un daemon calme ne pousse rien, ce panneau est sans ambiguïté : un refus signifie qu'un daemon a atteint le Hub et a été éconduit, jamais que la flotte est calme. Une ligne unauthorized persistante est une ImportApiKey expirée, gate_full signifie trop d'envois en même temps, write_timeout que l'écriture est retenue par le poll ou par la rétention, et bad_request comme too_large désignent l'exporteur plutôt que le Hub. Un push bloqué avant d'arriver, par une network policy par exemple, n'apparaît pas du tout ici : pas de requête, pas de refus.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(perf_sentinel_hub_import_rejected_total{job=~\"$job\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Findings stockés par environnement et statut",
      "description": "Les signatures de findings distinctes que le Hub stocke, par environnement et par statut. Le statut est propre à l'environnement, calculé comme le fait GET /api/findings?environment=, donc un finding encore vu en staging ne garde pas actif son double de production. Une gauge, pas un compteur : un finding calme change de statut et la rétention le supprime, donc chaque série descend autant qu'elle monte et increase() n'a de sens sur aucune d'elles. Contrairement au panneau des runs plus haut, une combinaison vide ne publie aucune série, donc une ligne qui s'arrête alors que les autres continuent signifie que cet état s'est vidé, pas que la collecte a échoué. Dessiné en lignes plutôt qu'empilé, puisqu'une signature vue dans deux environnements compte dans chacun et que le haut d'une pile ne serait pas un nombre de findings. Le Hub garde les comptes 15 secondes, donc deux collectes dans cet intervalle lisent la même valeur.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (environment, status) (perf_sentinel_hub_findings{job=~\"$job\"})",
          "refId": "A",
          "legendFormat": "{{environment}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "title": "Findings actifs par sévérité, $environment",
      "description": "Les findings actifs de l'environnement choisi plus haut, répartis par sévérité, dans les couleurs que leur donne le tableau de bord des findings du moteur. Actif signifie qu'un daemon de cet environnement a vu le finding dans le délai Hub:ResolutionGrace, 7 jours par défaut. Une sévérité hors des trois du moteur compte sous other au lieu d'ouvrir sa propre série. Une sévérité sans finding actif ne dessine aucune ligne, ce qui est le bon cas et non un trou.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (severity) (perf_sentinel_hub_findings{job=~\"$job\", environment=\"$environment\", status=\"active\"})",
          "refId": "A",
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "perf-sentinel",
    "perf-sentinel-hub",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(perf_sentinel_hub_build_info, job)",
        "query": {
          "query": "label_values(perf_sentinel_hub_build_info, job)",
          "refId": "job"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "environment",
        "label": "Environnement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(perf_sentinel_hub_findings{job=~\"$job\"}, environment)",
        "query": {
          "query": "label_values(perf_sentinel_hub_findings{job=~\"$job\"}, environment)",
          "refId": "environment"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "description": "L'environnement dessiné par Findings actifs par sévérité, parmi ceux que déclarent les sources du Hub. Un seul à la fois, parce qu'un finding vu dans deux environnements compte dans chacun et qu'une somme des deux ne serait pas un nombre de findings."
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "PerfSentinelHub, vue d'ensemble",
  "uid": "perf-sentinel-hub-overview",
  "version": 3
}
