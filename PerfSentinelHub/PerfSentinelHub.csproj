<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Version>0.1.7</Version>
        <InvariantGlobalization>false</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <!-- Implied by PublishAot at publish time, stated here so the generator
             also runs at build: an endpoint shape it cannot handle then fails
             here rather than at publish. It does not quiet the IDE, whose
             analysis does not run the generator and so reports IL2026/IL3050
             on every MapGet, warnings neither the build nor the binary has. -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
        <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
        <Copyright>Copyright (C) 2026 Robin Trassard</Copyright>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/robintra/PerfSentinelHub</RepositoryUrl>
        <!-- The LoggerMessage generator emits its class blocks in a different order on
             every run, which moves the PDB, which moves the deterministic content hash
             whose MVID the native image embeds. No PDB, no drift. Gated on a RID so the
             RID-less Release build the coverage and Sonar jobs run keeps its PDBs. -->
        <DebugType Condition="'$(RuntimeIdentifier)' != ''">none</DebugType>
        <!-- DebugType=none also turns off the objcopy pass that writes the .dbg and the
             /DEBUG that writes the native PDB, which would ship an empty symbols archive.
             Put it back, except on Apple where dsymutil runs anyway and -g moves the
             Mach-O UUID between two otherwise identical builds. -->
        <NativeDebugSymbols Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('osx'))">true</NativeDebugSymbols>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Data.Sqlite" />
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    </ItemGroup>

    <!-- link.exe stamps the PE header and the PDB signature from the wall clock unless
         told to derive them from the content. -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
        <LinkerArg Include="/Brepro" />
    </ItemGroup>

    <!-- ILC compiles with one thread per core by default, and the order it emits some
         symbols follows the order those threads finish. Two runners on one image then
         produce binaries differing by a few bytes in an indirection table, which the
         release workflow's byte-for-byte check rejects. Measured on osx-arm64: a
         parallel and a single-threaded build of one commit differ by 82 bytes, and the
         two release candidates differed by 83, sixteen of them the LC_UUID the linker
         derives from that content and the rest the ad-hoc signature over it. Applied to
         every RID rather than the one that failed: the cause is not platform specific,
         so the others are stable by luck. The jobs run in parallel, so the slower
         compile costs the release one job's worth of wall clock, not eight. -->
    <PropertyGroup>
        <IlcSingleThreaded>true</IlcSingleThreaded>
    </PropertyGroup>

    <!-- Every endpoint in this manifest carries a Last-Modified read from the mtime of
         the .gz/.br the build regenerates each run, so the file can never be byte stable.
         Nothing reads it: wwwroot is served by UseStaticFiles, which ETags from the file
         on disk, not by MapStaticAssets. Every .gz and .br still ships. -->
    <Target Name="DropStaticWebAssetEndpointsManifest" AfterTargets="CopyStaticWebAssetsEndpointsManifest">
        <Delete Files="$(PublishDir)$(TargetName).staticwebassets.endpoints.json" />
    </Target>

</Project>
